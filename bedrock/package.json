{
  "name": "enchantaholic-bedrock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "clean": "node -e \"for (const d of ['build','dist']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@minecraft/common": "1.3.0",
    "@minecraft/server": "2.10.0",
    "@minecraft/vanilla-data": "1.26.51",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
